# Игнорировать все папки, начинающиеся с точки (например, .venv, .idea, .vscode)
.*/
# Docker CI is source code, not a local hidden cache.
!.github/
!.github/workflows/
# Игнорировать все файлы с расширением .pt (модели PyTorch)
*.pt
*.pt.tmp
weights/
runs/
*.pdparams
*.pdopt
__pycache__/
*.py[cod]
.DS_Store

# Local experiment and credentials
.env
.env.*
!.env.example
work/
.runtime/
data/local/

# Generated video-comparison artifacts (large, reproducible)
reports/video-comparison/compatible/
reports/video-comparison/*.zip
reports/video-comparison/**/*.mp4

# A/B gate replay raw data (large crops/logs; report + CSV/JSON stay tracked)
reports/quality-gate/replay-comparison/runs/
